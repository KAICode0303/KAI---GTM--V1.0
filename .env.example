# Copy this file to `.env` (which git ignores) and fill in YOUR values. This example holds placeholders only:
# never put a real key in this file, and never commit `.env`.

# --- Model provider (Fireworks AI first; openai / anthropic are planned, same interface) ---
LLM_PROVIDER=fireworks
# Required. A Fireworks model id, e.g. accounts/fireworks/models/<model-name>. There is no default.
LLM_MODEL=accounts/fireworks/models/your-model-id
FIREWORKS_API_KEY=your-fireworks-api-key-here

# Optional tuning (values shown are the defaults)
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
# LLM_JSON_MODE=0

# --- Privacy: hosted calls send the question and the retrieved passages to the provider ---
# Leave at 0 until you have approved sending that text. Embeddings and the vector index always stay local.
RAG_ALLOW_HOSTED_CALLS=0

# --- Retrieval (provisional values; see eval/ for how they behave) ---
# RAG_MAX_DISTANCE=0.70
# RAG_CONTEXT_K=6
# RAG_CONTEXT_MAX_DISTANCE=
# RAG_CONTEXT_MARGIN=
# RAG_CONTEXT_MIN_CHUNKS=1
