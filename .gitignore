# --- Python environments and caches (never publish; recreated by pip / Python) ---
.venv/
.venv312/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- macOS and editor files ---
.DS_Store
.vscode/
.idea/

# --- Secrets: API keys live only in .env, which is never committed ---
.env
